---
import { Image } from 'astro:assets';
import { site } from '@/config/site';
import logo from '@/assets/brand/logo-planes-prepagas.png';

/**
 * Logo de Planes Prepagas (agregado 2026-10-01; reemplaza al monograma "PP").
 *
 * El PNG trae fondo transparente y colores navy/turquesa, así que solo se usa
 * sobre fondos claros. El archivo original está recortado al contenido: el
 * alto que se pide acá es el alto real del dibujo, sin margen vacío.
 */
interface Props {
  /** Alto de render en px. El ancho lo deduce Astro del aspecto original. */
  height?: number;
  /** true en el encabezado (arriba del pliegue); en el pie, false para no competir con lo visible. */
  eager?: boolean;
  class?: string;
}

const { height = 44, eager = true, class: className = '' } = Astro.props;
---

<Image
  src={logo}
  alt={site.name}
  height={height}
  densities={[1, 2]}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  class:list={['w-auto shrink-0', className]}
  style={`height: ${height}px`}
/>
