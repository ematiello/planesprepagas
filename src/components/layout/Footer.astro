---
import { getCollection } from 'astro:content';
import { site, legalNav, identity } from '@/config/site';
import CompanyLogo from '@/components/shared/CompanyLogo.astro';
import WhatsAppIcon from '@/components/shared/WhatsAppIcon.astro';
import { buildWhatsAppLink, genericEnquiryMessage } from '@/lib/whatsapp';

/*
 * El footer lista compañías, no planes: con varias cargadas la lista de planes
 * crece sin techo, mientras que la de compañías se mantiene corta y lleva al
 * catálogo de cada una.
 */
const companies = (await getCollection('companies')).sort((a, b) => a.data.order - b.data.order);

const year = new Date().getFullYear();
const whatsappHref = buildWhatsAppLink(genericEnquiryMessage());

/* Redes con perfil real cargado en site.ts; las vacías no se listan. */
const socialLinks = Object.entries(site.social).filter(([, url]) => url);

const institucional = [
  { label: 'Quiénes somos', href: '/quienes-somos' },
  { label: 'Planes para empresas', href: '/empresas' },
];

const ayuda = [
  { label: 'Preguntas frecuentes', href: '/preguntas-frecuentes' },
  { label: 'Contacto', href: '/contacto' },
];
---

<footer class="mt-auto bg-navy-900 text-navy-100">
  <div class="container-page grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <h2 class="font-display text-lg font-extrabold text-white">{site.name}</h2>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-navy-100/80">{site.tagline}</p>

      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
          data-analytics="whatsapp-footer"
        >
          <WhatsAppIcon />
          Escribinos
        </a>
        {/* Borde claro: el btn-outline estándar es navy y acá el fondo es navy. */}
        <a
          href={`mailto:${site.email}`}
          class="btn border-white/40 text-white hover:bg-white hover:text-navy-900"
          data-analytics="email-footer"
        >
          Enviar un mail
        </a>
      </div>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold uppercase tracking-widest text-white">
        Institucional
      </h3>
      <ul class="mt-4 flex flex-col gap-2.5 text-sm">
        {
          institucional.map((item) => (
            <li>
              <a href={item.href} class="text-navy-100/80 transition hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold uppercase tracking-widest text-white">
        Compañías
      </h3>
      <ul class="mt-4 flex flex-col items-start gap-3 text-sm">
        {
          companies.map((company) => (
            <li>
              <a
                href={`/companias/${company.id}`}
                class="inline-flex transition hover:opacity-80"
                aria-label={`Planes de ${company.data.name}`}
              >
                <CompanyLogo company={company} height={26} onDark decorative />
              </a>
            </li>
          ))
        }
        <li class="mt-1">
          <a href="/planes" class="text-navy-100/80 transition hover:text-white">
            Ver todos los planes
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold uppercase tracking-widest text-white">
        Ayuda y contacto
      </h3>
      <ul class="mt-4 flex flex-col gap-2.5 text-sm">
        {
          ayuda.map((item) => (
            <li>
              <a href={item.href} class="text-navy-100/80 transition hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={site.phones.sales.href}
            class="font-semibold text-white transition hover:text-amber-brand"
          >
            {site.phones.sales.label}
          </a>
        </li>
        <li>
          <a
            href={`mailto:${site.email}`}
            class="text-navy-100/80 transition hover:text-white"
          >
            {site.email}
          </a>
        </li>
      </ul>

      {/* Solo las redes con URL cargada. Sin ninguna, no se renderiza la lista. */}
      {
        socialLinks.length > 0 && (
          <ul class="mt-5 flex gap-4 text-sm">
            {socialLinks.map(([network, url]) => (
              <li>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="capitalize text-navy-100/80 transition hover:text-white"
                >
                  {network}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-5 py-8">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-xs">
        {
          legalNav.map((item) => (
            <li>
              <a href={item.href} class="text-navy-100/70 underline-offset-4 transition hover:text-white hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      {/*
        Nota de alcance: aclara que los planes son de cada compañía y que manda
        el contrato, no lo publicado acá. Protege sobre la exactitud de los
        beneficios listados y sobre el uso de marcas de terceros.
      */}
      {/*
        Nota de alcance. Decía "las compañías de medicina prepaga que representa":
        "representar" es una afirmación de vínculo formal con un tercero, y no
        hay documento que la respalde. Es uno de los motivos por los que Google
        Ads rechazó la cuenta ("hacer parecer que una empresa cuenta con el
        respaldo o afiliación de otra marca"). Ahora describe solo la actividad
        verificable: informar y asesorar.
      */}
      <p class="max-w-4xl text-xs leading-relaxed text-navy-100/60">
        {site.name} es un asesor independiente en medicina prepaga. No es una empresa de
        medicina prepaga, no forma parte de las compañías cuyos planes publica, no las
        representa ni actúa en su nombre, y ninguna de ellas respalda este sitio. Los
        planes exhibidos pertenecen a cada compañía, que es quien presta el servicio de
        salud, define las condiciones y percibe la cuota. Las condiciones, coberturas,
        carencias y valores definitivos son los que establece el contrato de la compañía.
        Las marcas y denominaciones citadas pertenecen a sus respectivos titulares y se
        usan con fines identificatorios.{' '}
        <a
          href="/legales/terminos"
          class="underline underline-offset-2 hover:text-white">Términos y condiciones</a
        >.
      </p>

      {/*
        Identidad del titular. Antes acá solo figuraba el dominio haciendo de
        razón social, que es literalmente no identificar a nadie.
      */}
      {
        identity.isComplete && (
          <p class="text-xs leading-relaxed text-navy-100/60">
            Titular del sitio:{' '}
            <strong class="font-semibold text-navy-100">{identity.legalName}</strong> —
            CUIT/CUIL {identity.taxId} — {identity.location}. {identity.form}. Atención
            exclusivamente a distancia.
          </p>
        )
      }

      <p class="text-xs text-navy-100/50">
        © {year} {identity.displayName} — Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
