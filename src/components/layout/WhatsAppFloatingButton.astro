---
import WhatsAppIcon from '@/components/shared/WhatsAppIcon.astro';
import { buildWhatsAppLink, genericEnquiryMessage } from '@/lib/whatsapp';

const href = buildWhatsAppLink(genericEnquiryMessage());
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-analytics="whatsapp-floating"
  class="fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-whatsapp px-4 py-3 font-display text-sm font-bold text-white shadow-lg transition hover:bg-whatsapp-dark hover:shadow-xl md:bottom-8 md:right-8"
>
  <WhatsAppIcon class="h-6 w-6" />
  <span class="hidden sm:inline">Consultar por WhatsApp</span>
  <span class="sr-only sm:hidden">Consultar por WhatsApp</span>
</a>
