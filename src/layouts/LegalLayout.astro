---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  lastUpdated: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="bg-navy-900 text-white">
    <div class="container-page py-14 md:py-16">
      <h1 class="max-w-3xl text-3xl md:text-4xl">{title}</h1>
      <p class="mt-3 text-sm text-navy-100/70">Última actualización: {lastUpdated}</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="legal-body prose-measure flex flex-col gap-4 text-sm leading-relaxed text-ink-muted">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Estilos del contenido legal, acotados a este layout para no chocar con el
     resto del sitio. */
  .legal-body :global(h2) {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    color: var(--color-ink);
  }

  .legal-body :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal-body :global(a) {
    color: var(--color-navy-900);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-body :global(strong) {
    color: var(--color-ink);
  }
</style>
