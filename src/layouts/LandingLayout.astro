---
import '@/styles/global.css';
import { site, legalNav, identity } from '@/config/site';
import { buildOrganizationSchema } from '@/lib/organization-schema';

/**
 * Layout de las landings de campaña. Difiere del BaseLayout a propósito:
 *
 * - **Sin header de navegación ni footer de links.** La landing recibe tráfico
 *   pago con una intención única; cada link que no sea el CTA es una ruta de
 *   escape que se paga y no convierte.
 * - **`noindex` en `/lp/[slug]`.** Si la landing de Ads se indexara, competiría
 *   con la versión indexable de la compañía por el mismo término. Hoy esa
 *   versión es la home (`indexable`), que lleva canonical y el JSON-LD de la
 *   organización; cuando vuelva el sitio general será `/companias/[slug]`.
 * - **Píxeles de Meta y Google Ads**, que el resto del sitio no carga.
 */
interface Props {
  title: string;
  description: string;
  /** Se usa en el aviso legal del pie, que sí es obligatorio. */
  companyName: string;
  /** true solo en la home: index + canonical + JSON-LD. Las /lp/ quedan noindex. */
  indexable?: boolean;
}

const { title, description, companyName, indexable = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const organizationSchema = indexable ? buildOrganizationSchema(Astro.site) : null;

const { gtmId, metaPixelId, googleAdsId, contactConversions } = site.tracking;

/* Snippet oficial de Google Tag Manager.
 *
 * Se arma acá como string y se inyecta con `set:html`: dentro de una expresión
 * JSX el contenido de un <script> se interpreta como hijos, y el código termina
 * emitido como texto que nunca se ejecuta. Con set:html sale literal.
 */
const gtmSnippet = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${gtmId}');`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Google Tag Manager, lo más arriba posible. Las landings son las páginas
        que más importa medir: pagamos cada visita. */}
    {
      gtmId && (
        <script is:inline set:html={gtmSnippet} />
      )
    }

    {/* Etiqueta de Google de la cuenta de Ads (gtag.js). Va junto al contenedor
        y no más abajo: en una landing paga, cada milisegundo de demora es un
        clic medido de menos. Trae su propio gtag.js porque `analyticsId` está
        vacío a propósito (GA4 se dispara desde GTM). */}
    {
      googleAdsId && (
        <>
          {!site.analyticsId && (
            <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAdsId}`} />
          )}
          <script is:inline define:vars={{ googleAdsId }}>
            window.dataLayer = window.dataLayer || [];
            if (!window.gtag) {
              function gtag() {
                window.dataLayer.push(arguments);
              }
              window.gtag = gtag;
              gtag('js', new Date());
            }
            window.gtag('config', googleAdsId);
          </script>
        </>
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      indexable ? (
        <link rel="canonical" href={canonical} />
      ) : (
        <meta name="robots" content="noindex, follow" />
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonical} />}
    {/* noindex no impide que alguien reenvíe el link por WhatsApp: la vista
        previa igual necesita imagen. */}
    <meta property="og:image" content={new URL('/og.jpg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {
      site.analyticsId && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`}
          />
          <script is:inline define:vars={{ analyticsId: site.analyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', analyticsId);
          </script>
        </>
      )
    }

    {
      metaPixelId && (
        <script is:inline define:vars={{ metaPixelId }}>
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          window.fbq('init', metaPixelId);
          window.fbq('track', 'PageView');
        </script>
      )
    }
    {
      organizationSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
      )
    }
  </head>

  <body
    class="flex min-h-screen flex-col bg-surface"
    data-ads-whatsapp={googleAdsId ? contactConversions.whatsapp : ''}
    data-ads-phone={googleAdsId ? contactConversions.phone : ''}
  >
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }

    <a
      href="#contenido"
      class="sr-only rounded-lg focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-navy-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    {/*
      Pie mínimo. No lleva navegación, pero sí los legales: Meta y Google Ads
      rechazan destinos sin política de privacidad accesible, y el descargo de
      intermediación es lo que sostiene el uso de la marca ajena.
    */}
    <footer class="border-t border-hairline bg-canvas">
      <div class="container-page flex flex-col gap-4 py-8">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-xs">
          {
            legalNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-ink-muted underline-offset-4 transition hover:text-navy-900 hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          {/* Quién está detrás del sitio, a un clic: es lo primero que revisa
              Google Ads al evaluar la identidad del anunciante. */}
          {
            [
              { label: 'Quiénes somos', href: '/quienes-somos' },
              { label: 'Contacto', href: '/contacto' },
            ].map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-ink-muted underline-offset-4 transition hover:text-navy-900 hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        {/*
          Descargo de no-afiliación. Dice "asesor independiente" y no "promotor":
          "promotor" sugiere un rol comercial delegado por la compañía, que es
          justamente el vínculo que no está documentado y que Google reprocha
          afirmar sin poder probarlo.

          Es el refuerzo del aviso que ya aparece arriba de todo en la landing:
          acá abajo repite, no estrena.
        */}
        <p class="max-w-4xl text-xs leading-relaxed text-ink-muted">
          <strong class="font-semibold text-ink">
            Este sitio pertenece a {site.name} y no es el sitio oficial de {companyName}.
          </strong>{' '}
          {site.name} es un asesor independiente en medicina prepaga: informa sobre los
          planes de {companyName} y no forma parte de esa compañía, no la representa ni
          actúa en su nombre. Los planes exhibidos pertenecen a {companyName}, que es
          quien presta el servicio de salud, define las condiciones y percibe la cuota.
          Las condiciones, coberturas, carencias y valores definitivos son los que
          establece el contrato de la compañía. {companyName} y su denominación
          pertenecen a su titular y se citan con fines identificatorios.
        </p>

        {/* Identidad del titular: quién responde por este sitio, con nombre y CUIT. */}
        {
          identity.isComplete && (
            <p class="text-xs leading-relaxed text-ink-muted">
              Titular del sitio: <strong class="font-semibold text-ink">{identity.legalName}</strong>{' '}
              — CUIT/CUIL {identity.taxId} — {identity.location}. Contacto:{' '}
              <a href={`mailto:${site.email}`} class="underline underline-offset-2">
                {site.email}
              </a>
              .
            </p>
          )
        }

        <p class="text-xs text-ink-muted/80">
          © {year} {identity.displayName} — Todos los derechos reservados.
        </p>
      </div>
    </footer>

    {/* Conversiones de Google Ads por clic a WhatsApp y teléfono. Sin ID de Ads
        o sin etiqueta, el atributo va vacío y el listener no mide nada. */}
    <script>
      import { trackContactClicks } from '@/lib/ads-conversion';

      trackContactClicks({
        whatsapp: document.body.dataset.adsWhatsapp ?? '',
        phone: document.body.dataset.adsPhone ?? '',
      });
    </script>
  </body>
</html>
