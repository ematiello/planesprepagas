---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import LegalIdentity from '@/components/shared/LegalIdentity.astro';

const values = [
  {
    title: 'Especialización',
    body: 'Conocemos en profundidad los planes que publicamos: carencias, copagos y letra chica, no de oído.',
  },
  {
    title: 'Claridad',
    body: 'Explicamos la letra chica antes de la firma: carencias, copagos y qué queda afuera de cada plan.',
  },
  {
    title: 'Continuidad',
    body: 'Seguimos siendo tu punto de contacto después del alta, cuando aparecen los trámites y las dudas.',
  },
];
---

<BaseLayout
  title="Quiénes somos"
  description={`${site.name} es un asesor independiente en medicina prepaga: no es una prepaga ni forma parte de ninguna. Te informamos sobre las coberturas disponibles y te acompañamos en la gestión ante la compañía que elijas.`}
>
  <section class="bg-navy-900 text-white">
    <div class="container-page py-16 md:py-24">
      <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-amber-brand">
        Quiénes somos
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl md:text-5xl">
        Traducimos una decisión que suele tomarse a ciegas
      </h1>
      <p class="prose-measure mt-5 text-lg leading-relaxed text-navy-100/85">
        {site.name} es un asesor independiente en medicina prepaga. Te ayudamos a entender
        en qué se diferencian los planes disponibles, a elegir el que corresponde a tu
        situación y te acompañamos en la gestión de la solicitud ante la compañía.
      </p>
      <p class="prose-measure mt-4 text-base leading-relaxed text-navy-100/70">
        No somos una empresa de medicina prepaga y no formamos parte de ninguna. La
        cobertura la presta —y la factura— la compañía que elijas.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:items-start">
      <div class="prose-measure flex flex-col gap-4 text-base leading-relaxed text-ink-muted">
        <h2 class="text-2xl text-ink">Qué hacemos exactamente</h2>
        <p>
          Nuestro trabajo es conocer al detalle los planes que publicamos, entender tu
          situación concreta y traducir una decisión que suele tomarse a ciegas en una
          elección entendible.
        </p>

        <h2 class="mt-4 text-2xl text-ink">Qué NO somos</h2>
        <p>
          No somos una empresa de medicina prepaga. No formamos parte de ninguna de las
          compañías cuyos planes publicamos, no las representamos, no actuamos en su
          nombre y ninguna de ellas respalda ni patrocina este sitio. Este no es el sitio
          oficial de ninguna de esas compañías.
        </p>
        <p>
          La cobertura médica la presta la compañía, el contrato lo firmás con ella y es
          ella quien te factura y te cobra la cuota. También es la compañía —no nosotros—
          quien decide si acepta o rechaza cada solicitud de afiliación. Nosotros
          intervenimos antes, asesorando, y después, acompañando trámites y consultas.
        </p>
        <p>
          No te cobramos nada por el asesoramiento y nuestra intervención no aumenta el
          valor de la cuota, que la fija la compañía.
        </p>

        <h2 class="mt-4 text-2xl text-ink">Quién responde por este sitio</h2>
        <p>
          Publicamos nuestros datos completos para que sepas con quién estás tratando
          antes de dejarnos cualquier información:
        </p>
        <LegalIdentity />
      </div>

      <div class="flex flex-col gap-4">
        {
          values.map((value) => (
            <div class="card p-6">
              <h3 class="font-display text-lg font-extrabold text-navy-900">
                {value.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{value.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-hairline bg-surface py-12">
    <div class="container-page flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
      <p class="prose-measure text-sm leading-relaxed text-ink-muted">
        Mirá los planes disponibles y escribinos con tu caso: te respondemos con las
        opciones que te sirven.
      </p>
      <a href="/planes" class="btn btn-primary shrink-0">Ver planes</a>
    </div>
  </section>
</BaseLayout>
