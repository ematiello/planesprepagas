---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';

// TODO: reemplazar por los datos reales del equipo y la trayectoria.
const values = [
  {
    title: 'Especialización',
    body: 'Conocemos en profundidad los planes de las compañías que representamos, no de oído.',
  },
  {
    title: 'Claridad',
    body: 'Explicamos la letra chica antes de la firma: carencias, copagos y qué queda afuera de cada plan.',
  },
  {
    title: 'Continuidad',
    body: 'Seguimos siendo tu punto de contacto después del alta, cuando aparecen los trámites y las dudas.',
  },
];
---

<BaseLayout
  title="Quiénes somos"
  description={`${site.name} comercializa planes de medicina prepaga. Te asesoramos para elegir la cobertura que corresponde a tu caso y acompañamos el trámite de alta.`}
>
  <section class="bg-navy-900 text-white">
    <div class="container-page py-16 md:py-24">
      <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-amber-brand">
        Quiénes somos
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl md:text-5xl">
        Traducimos una decisión que suele tomarse a ciegas
      </h1>
      <p class="prose-measure mt-5 text-lg leading-relaxed text-navy-100/85">
        {site.name} comercializa planes de medicina prepaga. Te ayudamos a entender en qué
        se diferencian, a elegir el que corresponde a tu situación y gestionamos el alta
        ante la compañía.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:items-start">
      <div class="prose-measure flex flex-col gap-4 text-base leading-relaxed text-ink-muted">
        <h2 class="text-2xl text-ink">Qué hacemos exactamente</h2>
        <p>
          Nuestro trabajo es conocer al detalle los planes de las compañías que
          representamos, entender tu situación concreta y traducir una decisión que suele
          tomarse a ciegas en una elección entendible.
        </p>
        <p>
          No formamos parte de ninguna de esas compañías: somos un intermediario
          independiente. La cobertura médica la presta la compañía y el contrato lo firmás
          con ella. Nosotros intervenimos antes —asesorando— y después —acompañando
          trámites, cambios de plan y consultas.
        </p>
        <p>
          No te cobramos nada por el asesoramiento: contratar con nuestra intervención no
          aumenta el valor de la cuota.
        </p>

        {/* TODO: sumar acá trayectoria real, cantidad de asociados, años en el mercado. */}
      </div>

      <div class="flex flex-col gap-4">
        {
          values.map((value) => (
            <div class="card p-6">
              <h3 class="font-display text-lg font-extrabold text-navy-900">
                {value.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{value.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-hairline bg-surface py-12">
    <div class="container-page flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
      <p class="prose-measure text-sm leading-relaxed text-ink-muted">
        Mirá los planes disponibles y escribinos con tu caso: te respondemos con las
        opciones que te sirven.
      </p>
      <a href="/planes" class="btn btn-primary shrink-0">Ver planes</a>
    </div>
  </section>
</BaseLayout>
