---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import LandingLayout from '@/layouts/LandingLayout.astro';
import CompanyLogo from '@/components/shared/CompanyLogo.astro';
import LeadForm from '@/components/landing/LeadForm.astro';
import WhoIsWho from '@/components/shared/WhoIsWho.astro';
import WhatsAppIcon from '@/components/shared/WhatsAppIcon.astro';
import { site } from '@/config/site';
import { contactFor } from '@/lib/contact';
import { buildWhatsAppLink, companyEnquiryMessage } from '@/lib/whatsapp';

/**
 * Landing de campaña, una por compañía. Recibe el tráfico de Meta y Google Ads.
 *
 * Se genera desde la misma colección que el resto del sitio: cuando entre una
 * compañía nueva, su landing existe sin escribir código.
 */
export const getStaticPaths = (async () => {
  const companies = await getCollection('companies');
  return companies.map((company) => ({ params: { slug: company.id }, props: { company } }));
}) satisfies GetStaticPaths;

const { company } = Astro.props;

const plans = (await getCollection('plans', ({ data }) => data.company.id === company.id)).sort(
  (a, b) => a.data.order - b.data.order,
);

const contact = contactFor(company);
/*
 * Las landings de campaña se atienden con una línea dedicada, distinta de la
 * general del sitio: separa el volumen que llega por publicidad paga del que
 * llega por el sitio.
 *
 * El número vive en `site.campaignLine` y no acá: /contacto lo publica y
 * explica por qué hay dos líneas en el mismo dominio. Dos números sin
 * explicación es una incoherencia de identidad que un revisor de Google
 * interpreta como dos empresas distintas.
 */
contact.whatsappNumber = site.campaignLine.whatsappNumber;
contact.phone = { label: site.campaignLine.label, href: site.campaignLine.href };
const whatsappHref = buildWhatsAppLink(
  companyEnquiryMessage(company.data.name),
  contact.whatsappNumber,
);
const planNames = plans.map((plan) => plan.data.name);

/* Qué vas a encontrar en esta página. Antes esta lista mezclaba beneficios de
   la cobertura con servicios nuestros, en una voz única que no dejaba ver quién
   ofrecía cada cosa. Ahora cada punto dice de quién es lo que promete. */
const trustPoints = [
  `${company.data.name} tiene red de prestadores en todo el país; la cartilla efectiva depende del plan y de la zona.`,
  `Hay planes de ${company.data.name} para personas, grupo familiar, monotributistas y empresas.`,
  'Según tu situación registral, puede corresponder derivar los aportes de tu obra social. Te explicamos si aplica a tu caso.',
  `Nuestro asesoramiento no tiene costo y no modifica el valor de la cuota que fija ${company.data.name}.`,
];

const steps = [
  {
    title: 'Nos dejás tus datos',
    body: 'Completás el formulario y se abre WhatsApp con tu consulta ya escrita. Te atiende un asesor de Planes Prepagas, no de la compañía.',
  },
  {
    title: 'Recibís la información',
    body: `Te explicamos cobertura, carencias y valores de referencia de los planes de ${company.data.name} que apliquen a tu edad y a tu grupo familiar. Sin compromiso.`,
  },
  {
    title: 'Decidís vos',
    body: `Si querés avanzar, te acompañamos a armar la solicitud. El alta la resuelve ${company.data.name}: es la compañía quien acepta o rechaza cada solicitud y con quien firmás el contrato.`,
  },
];

/*
 * FAQ. Las tres últimas preguntas son de identidad ("¿es el sitio oficial?",
 * "¿quién cobra?", "¿qué pasa con mis datos?") y son deliberadamente explícitas:
 * antes esa información vivía en una sola pregunta al final de un acordeón
 * cerrado, que es donde Google no la considera visible.
 */
const faq = [
  {
    q: '¿Cuánto sale la cuota?',
    a: `Depende del plan, de tu edad y de la composición del grupo familiar. Dejanos tus datos y te pasamos la información y el valor de los planes de ${company.data.name} que apliquen a tu caso, sin compromiso.`,
  },
  {
    q: '¿Puedo derivar los aportes de mi obra social?',
    a: 'En la mayoría de los casos sí, si estás en relación de dependencia o sos monotributista con obra social. La derivación reduce la cuota final; el trámite y los plazos dependen de tu situación registral.',
  },
  {
    q: '¿Desde cuándo puedo usar la cobertura?',
    a: 'Habitualmente desde la fecha de alta que confirma la compañía. Algunas prestaciones tienen períodos de carencia y las condiciones preexistentes se evalúan a partir de la declaración jurada de salud.',
  },
  {
    q: '¿Pago más por consultar desde acá?',
    a: `No. La cuota es la que fija ${company.data.name} según el plan, la edad y el grupo familiar. Nuestro asesoramiento no agrega recargos ni honorarios: no te cobramos nada y no facturamos la cuota.`,
  },
  {
    q: `¿Este es el sitio oficial de ${company.data.name}?`,
    a: `No. Este sitio pertenece a ${site.name} y no es el sitio oficial de ${company.data.name}. Somos asesores independientes: informamos sobre sus planes y respondemos consultas. No formamos parte de ${company.data.name} ni tenemos su representación. El sitio oficial de la compañía es ${company.data.website}.`,
  },
  {
    q: `¿Quién presta la cobertura y quién me cobra?`,
    a: `${company.data.name} en los dos casos. La compañía presta la cobertura, define la cartilla y los valores, emite la factura y cobra la cuota. ${site.name} solo asesora e informa: el contrato lo firmás con ${company.data.name}, no con nosotros.`,
  },
  {
    q: '¿Qué pasa con los datos que dejo en el formulario?',
    a: `El formulario no guarda nada en este sitio: arma un mensaje y abre WhatsApp en tu teléfono, y sos vos quien decide enviarlo. Los recibe ${site.name} para responder tu consulta. Si más adelante pedís avanzar con una solicitud, los datos necesarios se comparten con ${company.data.name}. Está detallado en nuestra política de privacidad.`,
  },
];
---

<LandingLayout
  title={`Planes de ${company.data.name}: información y asesoramiento | ${site.name}`}
  description={`${site.name}, asesores independientes en medicina prepaga, te explica los planes de ${company.data.name}: qué cubre cada uno y en qué se diferencian. Sitio no oficial de ${company.data.name}.`}
  companyName={company.data.name}
>
  {/*
    Encabezado con NUESTRA identidad al frente, no la de la compañía.

    La versión anterior invertía esto: mostraba el logo de Avalian a la
    izquierda y relegaba "Planes Prepagas" a un <span class="hidden ... sm:block">,
    es decir, oculto por debajo de 640 px. En mobile —de donde viene la mayor
    parte del tráfico de Ads— la primera pantalla del destino era el logo de
    Avalian y nada más. Ese es, textualmente, el patrón que Google Ads sanciona
    como "hacer parecer que es el sitio oficial de otra marca".

    Ahora el monograma y el nombre propio son lo primero, se ven en TODOS los
    breakpoints, y el logo de la compañía no vive en el header: aparece más
    abajo, etiquetado como el tema del que informamos.
  */}
  <header class="border-b border-hairline bg-white">
    <div class="container-page flex items-center justify-between gap-3 py-3">
      <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} — Inicio`}>
        <span
          class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-navy-900 font-display text-sm font-extrabold text-white"
          aria-hidden="true">PP</span
        >
        <span class="leading-tight">
          <span class="block font-display text-base font-extrabold text-navy-900">
            {site.name}
          </span>
          <span class="block text-[0.65rem] uppercase tracking-[0.14em] text-ink-muted">
            Asesores independientes
          </span>
        </span>
      </a>
      <a
        href={contact.phone.href}
        class="shrink-0 font-display text-sm font-bold text-navy-900 hover:text-amber-brand-dark"
      >
        {contact.phone.label}
      </a>
    </div>
  </header>

  {/*
    Aclaración de no-afiliación en la primera pantalla, no en el pie.

    Va acá arriba y con contraste suficiente para leerse de un vistazo: es la
    frase que un revisor de Google —o un usuario que llegó desde un anuncio—
    tiene que poder ver sin scrollear ni abrir nada.
  */}
  <div class="border-b border-amber-brand/30 bg-amber-brand/10">
    <div class="container-page py-2.5">
      <p class="text-center text-xs leading-relaxed text-ink md:text-[0.8rem]">
        <strong class="font-semibold">Este sitio pertenece a {site.name}</strong> y
        <strong class="font-semibold">no es el sitio oficial de {company.data.name}</strong>.
        Somos asesores independientes: informamos sobre sus planes. La cobertura la presta
        y la factura {company.data.name}.
      </p>
    </div>
  </div>

  <section class="relative overflow-hidden bg-navy-900 text-white">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"
      aria-hidden="true"
    >
    </div>

    <div
      class="container-page relative grid gap-10 py-12 md:py-16 lg:grid-cols-[1.05fr_26rem] lg:items-start lg:gap-14"
    >
      <div>
        <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-amber-brand">
          {site.name} · Asesoramiento independiente
        </p>

        {/*
          H1 anterior: "Cobertura médica Avalian para vos y tu familia" — escrito
          en la voz de la compañía, indistinguible del titular de su sitio
          oficial. El nuevo dice qué hace ESTA página (informar) y deja a la
          compañía como el tema, no como el emisor.
        */}
        <h1 class="mt-3 text-3xl leading-[1.12] md:text-5xl">
          Información sobre los planes de {company.data.name}
        </h1>
        <p class="prose-measure mt-5 text-lg leading-relaxed text-navy-100/85">
          Somos {site.name}, asesores independientes en medicina prepaga. Te explicamos
          qué cubre cada uno de los {plans.length} planes de {company.data.name}, en qué
          se diferencian y cuál se ajusta a tu caso, para que decidas con la información
          completa.
        </p>

        {/*
          El logo de la compañía, etiquetado. No encabeza la página: acompaña a
          una leyenda que dice explícitamente de quién es la marca y por qué
          está acá. Un logo suelto arriba de todo es lo que hace leer la página
          como el sitio oficial de esa marca.
        */}
        <div
          class="mt-7 flex items-center gap-4 rounded-lg border border-white/15 bg-white/5 p-4"
        >
          <CompanyLogo company={company} height={34} onDark decorative eager />
          <p class="text-xs leading-relaxed text-navy-100/75">
            Marca de {company.data.name}, la compañía que presta la cobertura. Se muestra
            con fines identificatorios; {site.name} no forma parte de esa compañía.
          </p>
        </div>

        <ul class="mt-7 flex flex-col gap-3">
          {
            trustPoints.map((point) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-navy-100/90">
                <svg
                  class="mt-0.5 h-5 w-5 shrink-0 text-amber-brand"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{point}</span>
              </li>
            ))
          }
        </ul>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp mt-8 lg:hidden"
          data-analytics="whatsapp-lp-hero"
        >
          <WhatsAppIcon />
          Consultar por WhatsApp
        </a>
      </div>

      {/* El formulario entra en pantalla sin scrollear: es el único objetivo de la página. */}
      <LeadForm
        companyName={company.data.name}
        whatsappNumber={contact.whatsappNumber}
        planOptions={planNames}
        variant="hero"
        id="consultar"
      />
    </div>
  </section>

  {/*
    Va inmediatamente después del hero, antes de los planes: la respuesta a
    "¿con quién estoy hablando?" tiene que llegar ANTES de que el visitante
    empiece a evaluar productos, no después de haber dejado sus datos.
  */}
  <WhoIsWho companyName={company.data.name} companyWebsite={company.data.website} />

  <section class="section border-t border-hairline">
    <div class="container-page">
      <h2 class="text-center text-3xl md:text-4xl">
        {plans.length === 1
          ? `El plan de ${company.data.name}`
          : `Los ${plans.length} planes de ${company.data.name}`}
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-base leading-relaxed text-ink-muted">
        La diferencia no es "más caro o más barato": cambia la cartilla, el esquema de
        copagos y los beneficios que vas a usar seguido.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          plans.map((plan) => (
            <article class="card flex h-full flex-col overflow-hidden p-6">
              {plan.data.image && (
                <img
                  src={plan.data.image}
                  alt=""
                  loading="lazy"
                  class="-mx-6 -mt-6 mb-5 h-40 w-[calc(100%+3rem)] object-cover"
                  aria-hidden="true"
                />
              )}
              <span
                class="mb-5 block h-1 w-12 rounded-full"
                style={`background-color: ${company.data.brandColor}`}
                aria-hidden="true"
              />
              <h3 class="font-display text-xl font-extrabold text-navy-900">
                {plan.data.name}
              </h3>
              <p class="mt-1.5 font-display text-sm font-bold text-ink">{plan.data.tagline}</p>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">{plan.data.summary}</p>

              <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-ink-muted">
                Ideal para
              </p>
              <p class="text-sm text-ink">{plan.data.audience}</p>

              <ul class="mt-5 flex flex-col gap-2">
                {plan.data.benefits.slice(0, 4).map((benefit) => (
                  <li class="flex items-start gap-2 text-sm leading-relaxed text-ink">
                    <svg
                      class="mt-1 h-4 w-4 shrink-0 text-amber-brand-dark"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>

              <div class="flex-1" />

              {/* Prellena el plan en el formulario en vez de sacar al visitante de la página. */}
              <a
                href="#consultar"
                class="btn btn-primary mt-6 w-full"
                data-plan-cta={plan.data.name}
              >
                Consultar por este plan
              </a>
            </article>
          ))
        }
      </div>

      <p class="mt-8 text-center text-xs leading-relaxed text-ink-muted">
        Información elaborada por {site.name} a partir de fuentes públicas, con fines
        orientativos. No reemplaza la documentación oficial vigente de {company.data.name}:
        las condiciones, carencias, cartilla y valores definitivos son los que establece el
        contrato de la compañía, que es quien los define y puede modificarlos.
      </p>
    </div>
  </section>

  <section class="border-y border-hairline bg-canvas py-14 md:py-20">
    <div class="container-page">
      <h2 class="text-center text-3xl md:text-4xl">
        Cómo es el proceso
      </h2>
      <ol class="mx-auto mt-10 grid max-w-4xl gap-8 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li class="flex flex-col items-center gap-3 text-center">
              <span
                class="grid h-11 w-11 place-items-center rounded-full bg-navy-900 font-display text-base font-extrabold text-amber-brand"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <h3 class="font-display text-lg font-extrabold text-navy-900">{step.title}</h3>
              <p class="text-sm leading-relaxed text-ink-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_26rem] lg:items-start">
      <div>
        <h2 class="text-3xl md:text-4xl">Preguntas frecuentes</h2>
        <div class="mt-8 flex flex-col divide-y divide-hairline border-y border-hairline">
          {
            faq.map((item) => (
              <details class="group py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-bold text-navy-900">
                  {item.q}
                  <span
                    class="shrink-0 text-amber-brand-dark transition group-open:rotate-45"
                    aria-hidden="true"
                  >
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9 4h2v12H9z" />
                      <path d="M4 9h12v2H4z" />
                    </svg>
                  </span>
                </summary>
                <p class="prose-measure mt-3 text-sm leading-relaxed text-ink-muted">
                  {item.a}
                </p>
              </details>
            ))
          }
        </div>
      </div>

      {/* Segunda instancia del formulario: quien llegó hasta acá no debería tener que volver arriba. */}
      <LeadForm
        companyName={company.data.name}
        whatsappNumber={contact.whatsappNumber}
        planOptions={planNames}
        id="consultar-pie"
      />
    </div>
  </section>

  {/* Barra fija solo en mobile: el formulario del hero ya quedó fuera de pantalla. */}
  <div
    class="sticky bottom-0 z-40 border-t border-hairline bg-white/95 p-3 backdrop-blur lg:hidden"
  >
    <a href="#consultar" class="btn btn-primary w-full">
      Consultar sobre los planes de {company.data.name}
    </a>
  </div>
</LandingLayout>
