---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import CompanyLanding from '@/components/landing/CompanyLanding.astro';

/**
 * Landing de campaña, una por compañía. Recibe el tráfico de Meta y Google Ads.
 * El contenido vive en `CompanyLanding`, que también se usa como home.
 */
export const getStaticPaths = (async () => {
  const companies = await getCollection('companies');
  return companies.map((company) => ({ params: { slug: company.id }, props: { company } }));
}) satisfies GetStaticPaths;

const { company } = Astro.props;
---

<CompanyLanding company={company} />
