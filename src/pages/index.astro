---
import { getEntry } from 'astro:content';
import CompanyLanding from '@/components/landing/CompanyLanding.astro';
import { site } from '@/config/site';

/**
 * Home: la landing de `site.homeCompany`, indexable.
 *
 * El sitio general está oculto (2026-10-01) hasta que se sumen más compañías.
 * La home anterior quedó en `_index.astro`; para volver a ella se borra este
 * archivo y se le quita el `_`.
 */
const company = await getEntry('companies', site.homeCompany);
if (!company) throw new Error(`site.homeCompany "${site.homeCompany}" no existe en src/content/companies/`);
---

<CompanyLanding company={company} indexable />
