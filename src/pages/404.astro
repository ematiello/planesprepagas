---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscás no existe o cambió de dirección."
>
  <section class="section">
    <div class="container-page">
      <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-amber-brand">
        Error 404
      </p>
      <h1 class="mt-3 text-4xl md:text-5xl">Esta página no existe</h1>
      <p class="prose-measure mt-4 leading-relaxed text-ink-muted">
        Puede que el enlace esté roto o que la página haya cambiado de dirección. Probá
        desde el comparador de planes.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/planes" class="btn btn-primary">Ver planes</a>
        <a href="/" class="btn btn-outline">Volver al inicio</a>
      </div>
    </div>
  </section>
</BaseLayout>
